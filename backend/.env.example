# Backend Production Environment Variables Example
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

# Authentication & Security
JWT_SECRET=your_super_secret_random_jwt_key_here

# Frontend Production URLs
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGIN=https://your-frontend-domain.com
